// PicoCalc demo: typing on the keyboard shows text on the screen.
// (Demo de saisie : clavier -> ecran texte, SPI MATERIELLE (bus 2 = SPI1).
// Entree = nouvelle ligne ; Retour arriere = efface ; Echap = efface l'ecran ; fleches = curseur.)

using System;
using System.Diagnostics;
using System.Threading;

namespace PicoCalc
{
    public class Program
    {
        // Le firmware plafonne a partir de 62,5 MHz. Si l'image est deformee, baisse cette valeur (ex. 25000000).
        private const int SpiFrequency = 62500000;

        private static readonly object ScreenLock = new object();
        private static PicoCalcTextScreen _screen;

        public static void Main()
        {
            // Short pause so the debugger/deployment can take control before the hardware is used
            Thread.Sleep(3000);

            PicoCalcDisplay display = new PicoCalcDisplay(SpiFrequency);

            Stopwatch sw = Stopwatch.StartNew();
            display.Init();
            Debug.WriteLine("Init: " + sw.ElapsedMilliseconds + " ms");

            _screen = new PicoCalcTextScreen(display);

            sw.Restart();
            _screen.ClearPanel();
            Debug.WriteLine("ClearPanel: " + sw.ElapsedMilliseconds + " ms");

            _screen.WriteLine("PicoCalc nanoFramework");
            _screen.WriteLine("SPI materielle, bus 2, " + (SpiFrequency / 1000000) + " MHz");
            _screen.WriteLine("Tape quelque chose :");

            sw.Restart();
            _screen.Flush();
            Debug.WriteLine("Premier Flush: " + sw.ElapsedMilliseconds + " ms");

            PicoCalcKeyboard keyboard = new PicoCalcKeyboard();
            keyboard.KeyDown += OnKeyDown;
            keyboard.Start();

            while (true)
            {
                sw.Restart();
                lock (ScreenLock)
                {
                    _screen.Flush();
                }

                long dt = sw.ElapsedMilliseconds;
                if (dt > 5)
                {
                    Debug.WriteLine("Flush: " + dt + " ms");
                }

                Thread.Sleep(20);
            }
        }

        private static void OnKeyDown(object sender, PicoCalcKeyEventArgs e)
        {
            lock (ScreenLock)
            {
                if (e.Code == PicoCalcKeys.Esc)
                {
                    _screen.Clear();
                }
                else if (e.Code == PicoCalcKeys.Left)
                {
                    _screen.SetCursor(_screen.CursorX - 1, _screen.CursorY);
                }
                else if (e.Code == PicoCalcKeys.Right)
                {
                    _screen.SetCursor(_screen.CursorX + 1, _screen.CursorY);
                }
                else if (e.Code == PicoCalcKeys.Up)
                {
                    _screen.SetCursor(_screen.CursorX, _screen.CursorY - 1);
                }
                else if (e.Code == PicoCalcKeys.Down)
                {
                    _screen.SetCursor(_screen.CursorX, _screen.CursorY + 1);
                }
                else if (e.HasChar)
                {
                    _screen.Write(e.Char == (char)PicoCalcKeys.Enter ? '\n' : e.Char);
                }
            }
        }
    }
}
