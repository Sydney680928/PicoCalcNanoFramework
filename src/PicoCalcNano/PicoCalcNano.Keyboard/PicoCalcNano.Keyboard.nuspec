<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>PicoCalcNano.Keyboard</id>
    <version>$version$</version>
    <title>PicoCalcNano.Keyboard</title>
    <authors>Stéphane Sibué</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
	<license type="expression">Apache-2.0</license>
    <readme>docs\README.md</readme>
    <developmentDependency>false</developmentDependency>
    <projectUrl>https://github.com/sydney680928/PicoCalcNanoFramework</projectUrl>
    <icon>images\logo.png</icon>
    <repository type="git" url="https://github.com/sydney680928/PicoCalcNanoFramework" />
    <copyright>Copyright (c) Stéphane Sibué</copyright>
    <description>Keyboard driver for the Clockwork PicoCalc on .NET nanoFramework. Community project, not affiliated with Clockwork.</description>
    <tags>nanoFramework C# csharp picocalc keyboard rp2040 rp2350 pico</tags>
    <dependencies>
      <dependency id="nanoFramework.CoreLibrary" version="1.17.11" />
      <dependency id="nanoFramework.System.Device.I2c" version="1.1.29" />
    </dependencies>
  </metadata>
<files>
  <file src="bin\Release\PicoCalcNano.Keyboard.dll"  target="lib\PicoCalcNano.Keyboard.dll" />
  <file src="bin\Release\PicoCalcNano.Keyboard.pdb"  target="lib\PicoCalcNano.Keyboard.pdb" />
  <file src="bin\Release\PicoCalcNano.Keyboard.pdbx" target="lib\PicoCalcNano.Keyboard.pdbx" />
  <file src="bin\Release\PicoCalcNano.Keyboard.pe"   target="lib\PicoCalcNano.Keyboard.pe" />
  <file src="..\..\..\docs\keyboard.md"  target="docs\README.md" />
  <file src="..\..\..\images\logo128.png" target="images\logo.png" />
  <file src="..\..\..\LICENSE" target="LICENSE.md" />
</files>
</package>